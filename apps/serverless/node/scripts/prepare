#!/usr/bin/env sh

# Start DynamoDB Local (skip if already running)
docker ps --format '{{.Names}}' | grep -q '^dynamodb-local$' \
    || docker start dynamodb-local 2>/dev/null \
    || docker run -d --name dynamodb-local -p 8000:8000 amazon/dynamodb-local

# Wait for it to be ready
until curl -s http://localhost:8000 >/dev/null 2>&1; do
    sleep 0.5
done

# Create table (ignore error if already exists)
aws dynamodb create-table \
    --table-name users-table-dev \
    --attribute-definitions AttributeName=userId,AttributeType=S \
    --key-schema AttributeName=userId,KeyType=HASH \
    --billing-mode PAY_PER_REQUEST \
    --endpoint-url http://localhost:8000 \
    --no-cli-pager 2>/dev/null || true

echo "[ INFO ] DynamoDB on port 8000"
